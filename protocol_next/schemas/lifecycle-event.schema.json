{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol-next.dev/schemas/lifecycle-event-v1.json",
  "title": "Protocol Next Lifecycle Event",
  "type": "object",
  "required": ["type", "run_id", "occurred_at"],
  "properties": {
    "type": {"enum": ["run.started", "input.changed", "work.completed", "gate.decided", "run.completed"]},
    "run_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "minLength": 1},
    "data": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
