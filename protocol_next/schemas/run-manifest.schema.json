{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol-next.dev/schemas/run-manifest-v1.json",
  "title": "Protocol Next Run Manifest",
  "type": "object",
  "required": ["run_id", "started_at", "decision", "identifiers", "hashes"],
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string"},
    "decision": {"$ref": "decision.schema.json"},
    "identifiers": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "artifacts": {"type": "object", "additionalProperties": {"type": "string"}},
    "metadata": {"type": "object", "additionalProperties": true},
    "configuration": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
