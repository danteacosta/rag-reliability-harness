{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol-next.dev/schemas/decision-v1.json",
  "title": "Protocol Next Gate Decision",
  "type": "object",
  "required": ["outcome"],
  "properties": {
    "outcome": {"enum": ["pass", "fail"]},
    "reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "pass"}}},
      "then": {"properties": {"reasons": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "fail"}}},
      "then": {"required": ["reasons"], "properties": {"reasons": {"minItems": 1}}}
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "reason": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      },
      "additionalProperties": true
    }
  }
}
